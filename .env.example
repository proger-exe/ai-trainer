# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=
# Google Gemini API key (used through AtlantSDK for analysis / toxicity models)
GEMINI_API_TOKEN=
# Comma-separated Telegram IDs with admin access
ADMIN_IDS=
# Invite link shown to users after onboarding
NETWORK_CHAT_LINK=https://t.me/your_network_chat

# Optional: onboarding quiz hosted on your site (WebApp). Leave empty to run the quiz inside the bot.
ONBOARDING_WEBAPP_URL=
# Optional: Supabase project that stores quiz results from the site; poller is disabled when empty
SUPABASE_URL=
SUPABASE_KEY=

# HTTP API for the site integration (see docs/onboarding_integration.md)
API_HOST=0.0.0.0
API_PORT=8080

DATABASE_PATH=bot.db
MODELS_PATH=models.json
SYNTAX_PATH=syntax.json
